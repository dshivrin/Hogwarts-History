{
  "additionalProperties": false,
  "properties": {
    "author": {
      "title": "Author",
      "type": "string"
    },
    "canon_status": {
      "const": "non-canon fanfiction",
      "default": "non-canon fanfiction",
      "title": "Canon Status",
      "type": "string"
    },
