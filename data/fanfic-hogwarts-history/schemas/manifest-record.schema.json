      "pattern": "^[0-9a-f]{64}$",
      "title": "Chapter Pdf Sha256",
      "type": "string"
    },
    "chapter_title": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "title": "Chapter Title"
    },
    "chapter_url": {
      "format": "uri",
      "maxLength": 2083,
      "minLength": 1,
      "title": "Chapter Url",
      "type": "string"
    },
    "clean_html_path": {
      "format": "path",
      "title": "Clean Html Path",
      "type": "string"
    },
    "clean_html_sha256": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Clean Html Sha256",
      "type": "string"
    },
    "complete_pdf_path": {
      "format": "path",
      "title": "Complete Pdf Path",
      "type": "string"
    },
    "complete_pdf_sha256": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Complete Pdf Sha256",
      "type": "string"
    },
