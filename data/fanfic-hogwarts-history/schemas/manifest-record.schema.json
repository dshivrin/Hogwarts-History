    "raw_html_path": {
      "format": "path",
      "title": "Raw Html Path",
      "type": "string"
    },
    "raw_sha256": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Raw Sha256",
      "type": "string"
    },
