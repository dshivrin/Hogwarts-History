      "type": "string"
    },
    "dataset_version": {
      "default": "1.0",
      "title": "Dataset Version",
      "type": "string"
    },
    "expected_available_chapter_count": {
      "title": "Expected Available Chapter Count",
      "type": "integer"
    },
    "fan_created": {
      "const": true,
      "default": true,
      "title": "Fan Created",
      "type": "boolean"
    },
    "platform": {
      "title": "Platform",
      "type": "string"
    },
    "published_date_displayed": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
