      "format": "date-time",
      "title": "Retrieved At Utc",
      "type": "string"
    },
    "source_id": {
      "title": "Source Id",
      "type": "string"
    },
    "text_path": {
      "format": "path",
      "title": "Text Path",
      "type": "string"
    },
    "text_sha256": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Text Sha256",
      "type": "string"
